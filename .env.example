# Copy this file to .env (same folder) and fill in the keys of the providers you use.
# .env is ignored by git: never commit real keys. Leave unused keys empty.

# ---- LLM providers --------------------------------------------------------------
# Used by fabdata-llm to call the models (benchmark runs and translation). Which key a
# model needs is set in fab-benchmarks-configs/custom_models.yaml (Api_Key_Env_Var),
# or is the provider's default name below.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Google models, also used by translate_benchmark.py (its default model is Gemini)
GEMINI_API_KEY=
MISTRAL_API_KEY=
XAI_API_KEY=
FIREWORKS_API_KEY=
OPENROUTER_API_KEY=
HUGGINGFACE_API_KEY=
MOONSHOT_API_KEY=
SCALEWAY_API_KEY=
BEDROCK_API_KEY=
BYTEDANCE_API_KEY=
TENCENT_API_KEY=
LINGYIWANWU_API_KEY=

# ---- Leaderboard upload -------------------------------------------------------------
# Only for scripts/format_data_web.py --upload dev|beta|prod (Azure Blob Storage key of the
# fabdatastorage account). Not needed to generate the files locally.
AZURE_STORAGE_KEY=
